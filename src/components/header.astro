---
import { profile } from "~/data/profile";
import type { PageSection } from "~/data/sections";

import Grain from "./grain.astro";

interface Props {
  sections: PageSection[];
}

const { sections } = Astro.props;

const themes = [
  {
    paths: [
      "M4.5 4h15A1.5 1.5 0 0 1 21 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 14.5v-9A1.5 1.5 0 0 1 4.5 4z",
      "M8.5 20h7M12 16v4",
    ],
    value: "system",
  },
  {
    paths: [
      "M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0z",
      "M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4",
    ],
    value: "light",
  },
  {
    paths: ["M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"],
    value: "dark",
  },
] as const;
---

<header class="site-header" data-header transition:persist="site-header">
  <div class="bar" data-header-bar>
    <Grain class="bar-grain" id="header-grain" />
    <a class="brand" href="/">
      {profile.name}
    </a>
    <nav aria-label="Sections" class="nav">
      <ul>
        {sections.map((section) => (
          <li>
            <a data-nav-link={section.id} href={`/#${section.id}`}>
              {section.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <button
      aria-label="Theme: System"
      class="icon-btn theme-toggle"
      data-theme-toggle
      type="button"
    >
      {themes.map((theme) => (
        <svg
          aria-hidden="true"
          class="theme-icon"
          data-theme-icon={theme.value}
          fill="none"
          height="18"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="1.7"
          viewBox="0 0 24 24"
          width="18"
        >
          {theme.paths.map((path) => (
            <path d={path} />
          ))}
        </svg>
      ))}
    </button>
  </div>
  <span aria-live="polite" class="sr-only" data-theme-status></span>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    justify-content: center;
    padding: 12px 12px 0;
    pointer-events: none;
  }

  .bar {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    width: 100%;
    min-height: 48px;
    padding: 2px 2px 2px 8px;
    overflow: hidden;
    pointer-events: auto;
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 14px;
    transition:
      width 0.6s var(--ease-out),
      padding 0.6s var(--ease-out),
      background-color 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.6s var(--ease-out);
  }

  .bar.is-compact {
    padding-left: 14px;
    background-color: var(--glass);
    border-color: var(--line);
    box-shadow: var(--shadow);
    transform: translateY(6px);
  }

  .bar :global(.bar-grain) {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .bar.is-compact :global(.bar-grain) {
    opacity: var(--grain-opacity);
  }

  .brand {
    position: relative;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav {
    position: relative;
    display: none;
    justify-content: center;
  }

  .nav ul {
    display: flex;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 9px;
    font-size: 14px;
    color: var(--fg-2);
    text-decoration: none;
    border-radius: 9px;
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .nav a:hover,
  .nav a[aria-current="true"] {
    color: var(--fg);
  }

  .nav a:hover {
    background: var(--hover);
  }

  .theme-toggle {
    position: relative;
    grid-column: 3;
    width: 44px;
    height: 44px;
  }

  /* The bar clips its overflow, so focus rings sit inside its items. */
  .bar a:focus-visible,
  .bar button:focus-visible {
    outline-offset: -2px;
  }

  .theme-icon {
    display: none;
    animation: pop 0.35s var(--ease-out) both;
  }

  :global([data-theme-pref="system"]) [data-theme-icon="system"],
  :global([data-theme-pref="light"]) [data-theme-icon="light"],
  :global([data-theme-pref="dark"]) [data-theme-icon="dark"] {
    display: block;
  }

  :global(:root:not(.js)) .theme-toggle {
    visibility: hidden;
  }

  @media (min-width: 960px) {
    .site-header {
      padding-top: 14px;
    }

    .bar {
      width: var(--content);
      padding: 4px 0;
    }

    .bar.is-compact {
      width: 480px;
      padding: 4px 4px 4px 14px;
    }

    .nav {
      display: flex;
    }

    .theme-toggle {
      width: 40px;
      height: 40px;
    }
  }

  @supports (backdrop-filter: blur(1px)) {
    .bar.is-compact {
      backdrop-filter: blur(16px) saturate(1.5);
    }
  }
</style>

<script>
  import { subscribeToScroll } from "~/scripts/scroll-state";

  type ThemePreference = "system" | "light" | "dark";

  const COMPACT_AFTER = 24;
  const THEME_ORDER: ThemePreference[] = ["system", "light", "dark"];
  const THEME_LABELS: Record<ThemePreference, string> = {
    dark: "Dark",
    light: "Light",
    system: "System",
  };
  const root = document.documentElement;
  const bar = document.querySelector<HTMLElement>("[data-header-bar]");
  const toggle = document.querySelector<HTMLButtonElement>(
    "[data-theme-toggle]"
  );
  const status = document.querySelector<HTMLElement>("[data-theme-status]");
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]");
  const system = window.matchMedia("(prefers-color-scheme: dark)");

  const isPreference = (value: unknown): value is ThemePreference =>
    value === "system" || value === "light" || value === "dark";

  const currentPreference = (): ThemePreference =>
    isPreference(root.dataset.themePref) ? root.dataset.themePref : "system";

  const nextPreference = (preference: ThemePreference): ThemePreference =>
    THEME_ORDER[(THEME_ORDER.indexOf(preference) + 1) % THEME_ORDER.length] ??
    "system";

  const resolveTheme = (preference: ThemePreference) => {
    if (preference !== "system") {
      return preference;
    }
    return system.matches ? "dark" : "light";
  };

  const syncToggle = (preference: ThemePreference) => {
    const label = `Theme: ${THEME_LABELS[preference]}`;
    toggle?.setAttribute(
      "aria-label",
      `${label}. Switch to ${THEME_LABELS[nextPreference(preference)]}`
    );
    toggle?.setAttribute("title", label);
  };

  const applyPreference = (preference: ThemePreference) => {
    root.dataset.themePref = preference;
    root.dataset.theme = resolveTheme(preference);
    syncToggle(preference);
    if (status) {
      status.textContent = `Theme: ${THEME_LABELS[preference]}`;
    }
    try {
      if (preference === "system") {
        localStorage.removeItem("theme");
      } else {
        localStorage.setItem("theme", preference);
      }
    } catch {
      // Storage can be unavailable (private mode); the theme still applies for this visit.
    }
  };

  syncToggle(currentPreference());

  toggle?.addEventListener("click", () => {
    applyPreference(nextPreference(currentPreference()));
  });

  system.addEventListener("change", () => {
    if (currentPreference() === "system") {
      root.dataset.theme = resolveTheme("system");
    }
  });

  // The header persists across pages, so whether it mirrors the active section is
  // decided on every update rather than once.
  subscribeToScroll(({ y, active }) => {
    bar?.classList.toggle("is-compact", y > COMPACT_AFTER);
    const isHome = window.location.pathname === "/";
    for (const link of links) {
      link.setAttribute(
        "aria-current",
        String(isHome && link.dataset.navLink === active)
      );
    }
  });
</script>
