---
import { profile, socials } from "~/data/profile";

import CopyButton from "./copy-button.astro";
import CvButton from "./cv-button.astro";

const profileLinks = socials.filter((social) => social.label !== "X");

// Monochrome brand marks (Simple Icons, CC0).
const marks: Record<string, string> = {
  GitHub:
    "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  LinkedIn:
    "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zM7.119 20.452H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
};
---

<section aria-labelledby="hero-statement" class="hero" id="top">
  <p class="name enter" style="--delay: 80ms">
    {profile.name}
  </p>
  <p class="role muted enter" style="--delay: 140ms">
    {profile.role}
  </p>
  <h1 class="statement enter" id="hero-statement" style="--delay: 220ms">
    {profile.statement}
  </h1>
  <p class="context muted enter" style="--delay: 320ms">
    {profile.context}
  </p>
  <div class="actions enter" style="--delay: 420ms">
    <CopyButton
      accessibleLabel={`Copy email address ${profile.email}`}
      label="Copy email"
      text={profile.email}
      variant="primary"
    />
    <CvButton />
    <span aria-hidden="true" class="divider"></span>
    <span class="socials">
      {profileLinks.map((social) => (
        <a
          class="btn btn-icon"
          href={social.href}
          rel="me noopener"
          target="_blank"
          title={social.label}
        >
          <svg
            aria-hidden="true"
            fill="currentColor"
            height="18"
            viewBox="0 0 24 24"
            width="18"
          >
            <path d={marks[social.label]} />
          </svg>
          <span class="sr-only">{social.label}</span>
        </a>
      ))}
    </span>
  </div>
  <p class="recently enter" style="--delay: 520ms">
    <b>Recently</b>
    {` · ${profile.recently}`}
  </p>
</section>

<style>
  .hero {
    padding-top: 56px;
    text-align: center;
  }

  .name {
    font-weight: 500;
  }

  .role {
    margin-top: 2px;
  }

  .statement {
    max-width: 540px;
    margin: 28px auto 0;
    font-size: 24px;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .context {
    max-width: 470px;
    margin: 16px auto 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin-top: 28px;
  }

  .socials {
    display: inline-flex;
    gap: 8px;
  }

  /* Separates the two actions from the profile links; hidden when they wrap. */
  .divider {
    display: none;
    width: 1px;
    height: 20px;
    margin: 0 4px;
    background: var(--underline);
    opacity: 0.6;
  }

  .recently {
    margin-top: 40px;
    font-size: 14px;
    color: var(--fg-2);
  }

  .recently b {
    font-weight: 500;
    color: var(--fg);
  }

  @media (min-width: 640px) {
    .hero {
      padding-top: 84px;
    }

    .statement {
      margin-top: 36px;
      font-size: 28px;
      letter-spacing: -0.022em;
    }

    .context {
      margin-top: 18px;
    }

    .actions {
      margin-top: 32px;
    }

    .divider {
      display: block;
    }

    .recently {
      margin-top: 56px;
    }
  }

  @supports (text-wrap: balance) {
    .statement,
    .context,
    .recently {
      text-wrap: balance;
    }
  }
</style>
