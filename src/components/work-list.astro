---
import { getCollection } from "astro:content";

import SectionTitle from "./section-title.astro";

const entries = await getCollection("work");
const projects = entries.toSorted((a, b) => a.data.order - b.data.order);
const DEFAULT_OPEN = 0;
---

<section
  aria-labelledby="work-title"
  class="section"
  data-reveal
  data-section="work"
  id="work"
>
  <SectionTitle id="work-title" orb="lavender" title="Selected work" />
  <ul class="list">
    {projects.map((project, index) => {
      const isOpen = index === DEFAULT_OPEN;
      const triggerId = `work-trigger-${project.id}`;
      const panelId = `work-panel-${project.id}`;
      return (
        <li class:list={["item", { "is-open": isOpen }]} data-accordion-item>
          <h3 class="item-heading">
            <button
              aria-controls={panelId}
              aria-expanded={isOpen ? "true" : "false"}
              class="row"
              data-accordion-trigger
              data-preview-label={project.data.previewLabel}
              data-preview-metric={project.data.highlight}
              data-preview-name={project.data.name}
              data-preview-tone={project.data.tone}
              id={triggerId}
              type="button"
            >
              <span class="row-text">
                <span class="row-name">{project.data.name}</span>
                <span class="row-summary">{project.data.summary}</span>
              </span>
              <span class="row-highlight num">{project.data.highlight}</span>
              <svg
                aria-hidden="true"
                class="row-icon"
                fill="none"
                height="16"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-width="1.8"
                viewBox="0 0 24 24"
                width="16"
              >
                <path d="M12 5v14M5 12h14" />
              </svg>
            </button>
          </h3>
          <section
            aria-labelledby={triggerId}
            class="panel"
            data-accordion-panel
            id={panelId}
            inert={!isOpen}
          >
            <div class="panel-inner">
              <dl class="facts">
                <div class="fact">
                  <dt>Role</dt>
                  <dd>{project.data.role}</dd>
                </div>
                {project.data.problem && (
                  <div class="fact">
                    <dt>Problem</dt>
                    <dd>{project.data.problem}</dd>
                  </div>
                )}
                <div class="fact">
                  <dt>Decisions</dt>
                  <dd>
                    <ul class="decisions">
                      {project.data.decisions.map((decision) => (
                        <li>{decision.choice}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div class="fact">
                  <dt>Result</dt>
                  <dd>{project.data.outcome}</dd>
                </div>
                <div class="fact fact-links">
                  <dt class="sr-only">Links</dt>
                  <dd class="links">
                    <a data-astro-prefetch href={`/work/${project.id}/`}>
                      Read the case study <span aria-hidden="true">→</span>
                    </a>
                    {project.data.links.map((link) => (
                      <a
                        href={link.href}
                        rel="noopener noreferrer"
                        target="_blank"
                      >
                        {link.label} <span aria-hidden="true">↗</span>
                      </a>
                    ))}
                  </dd>
                </div>
              </dl>
            </div>
          </section>
        </li>
      );
    })}
  </ul>
</section>

<div aria-hidden="true" class="preview" data-preview>
  <div class="preview-card">
    <div class="preview-thumb" data-preview-thumb>
      <span class="preview-name" data-preview-name></span>
      <span class="preview-metric num" data-preview-metric></span>
    </div>
  </div>
  <span class="preview-pill" data-preview-pill></span>
</div>

<style>
  .item-heading {
    font: inherit;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 18px;
    gap: 12px;
    align-items: center;
    width: 100%;
    padding: 14px 4px;
    margin: 2px 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    background: none;
    border: 0;
    border-radius: 10px;
  }

  .row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .row-name {
    font-weight: 500;
  }

  .row-summary,
  .row-highlight {
    font-size: 14px;
    color: var(--fg-2);
  }

  .row-highlight {
    white-space: nowrap;
  }

  .row-icon {
    color: var(--fg-2);
    transition:
      transform 0.45s var(--ease-out),
      color 0.2s ease;
  }

  .is-open .row-icon {
    color: var(--fg);
    transform: rotate(45deg);
  }

  .panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--ease-out);
  }

  .is-open .panel {
    grid-template-rows: 1fr;
  }

  .panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  .facts {
    padding: 2px 4px 22px;
  }

  .fact {
    padding: 6px 0;
    opacity: 0;
    filter: blur(2px);
    transform: translateY(-4px);
    transition:
      opacity 0.2s ease,
      transform 0.3s var(--ease-out),
      filter 0.3s ease;
  }

  .is-open .fact {
    opacity: 1;
    filter: none;
    transform: none;
    transition-duration: 0.45s;
  }

  .is-open .fact:nth-child(1) {
    transition-delay: 0.08s;
  }

  .is-open .fact:nth-child(2) {
    transition-delay: 0.13s;
  }

  .is-open .fact:nth-child(3) {
    transition-delay: 0.18s;
  }

  .is-open .fact:nth-child(4) {
    transition-delay: 0.23s;
  }

  .is-open .fact:nth-child(5) {
    transition-delay: 0.28s;
  }

  dt {
    font-size: 13px;
    color: var(--fg-2);
  }

  .decisions {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 18px;
    margin-top: 2px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
  }

  .links a {
    display: inline-flex;
    gap: 4px;
    align-items: center;
    min-height: 40px;
    font-weight: 500;
  }

  .preview {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 40;
    display: none;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform;
  }

  .preview.is-visible {
    opacity: 1;
  }

  .preview-card {
    width: 236px;
    padding: 5px;
    background: var(--card);
    border-radius: 14px;
    box-shadow: var(--shadow);
    transform: scale(0.86) rotate(-2deg);
    transition: transform 0.4s var(--ease-out);
  }

  .preview.is-visible .preview-card {
    transform: none;
  }

  .preview-thumb {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 150px;
    padding: 12px;
    color: #111111;
    background: var(--orb-lavender);
    border-radius: 10px;
  }

  .preview-thumb[data-tone="rose"] {
    background: radial-gradient(
      circle at 70% 30%,
      #ffeaf4,
      #f6c4dc 45%,
      #f9d7ae
    );
  }

  .preview-thumb[data-tone="mint"] {
    background: radial-gradient(
      circle at 30% 70%,
      #ebfbec,
      #aee3b8 50%,
      #8ccfa2
    );
  }

  .preview-thumb[data-tone="peach"] {
    background: radial-gradient(
      circle at 60% 60%,
      #fff2e4,
      #f7cfae 45%,
      #d8cbf2
    );
  }

  .preview-name {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .preview-metric {
    font-size: 22px;
    letter-spacing: -0.02em;
  }

  .preview-pill {
    position: absolute;
    bottom: -14px;
    left: -12px;
    padding: 6px 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--bg);
    white-space: nowrap;
    background: var(--fg);
    border-radius: 9px;
    opacity: 0;
    transform: scale(0.8) translateY(4px);
    transition:
      transform 0.4s 0.05s var(--ease-out),
      opacity 0.25s 0.05s ease;
  }

  .preview.is-visible .preview-pill {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr) auto 20px;
      gap: 16px;
    }

    .fact {
      display: grid;
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 16px;
      padding: 7px 0;
    }

    dt {
      font-size: 14px;
    }

    .decisions {
      margin-top: 0;
    }

    .fact-links .links {
      grid-column: 2;
    }

    .facts {
      padding-bottom: 24px;
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 960px) {
    .preview {
      display: block;
    }
  }
</style>

<script>
  import type { Cleanup } from "~/scripts/lifecycle";
  import { onPage } from "~/scripts/lifecycle";
  import { prefersReducedMotion } from "~/scripts/motion";

  const PREVIEW_OFFSET_X = 28;
  const PREVIEW_OFFSET_Y = -84;
  const FOLLOW_EASING = 0.2;

  const setOpen = (item: HTMLElement, open: boolean) => {
    const trigger = item.querySelector<HTMLButtonElement>(
      "[data-accordion-trigger]"
    );
    const panel = item.querySelector<HTMLElement>("[data-accordion-panel]");
    item.classList.toggle("is-open", open);
    trigger?.setAttribute("aria-expanded", String(open));
    if (panel) {
      panel.inert = !open;
    }
  };

  const setupAccordion = () => {
    const items = document.querySelectorAll<HTMLElement>(
      "[data-accordion-item]"
    );

    for (const item of items) {
      const trigger = item.querySelector<HTMLButtonElement>(
        "[data-accordion-trigger]"
      );
      trigger?.addEventListener("click", () => {
        const willOpen = !item.classList.contains("is-open");
        for (const other of items) {
          if (other !== item) {
            setOpen(other, false);
          }
        }
        setOpen(item, willOpen);
      });
    }
  };

  const fillPreview = (preview: HTMLElement, trigger: HTMLElement) => {
    const { previewTone, previewName, previewMetric, previewLabel } =
      trigger.dataset;
    const thumb = preview.querySelector<HTMLElement>("[data-preview-thumb]");
    if (thumb) {
      thumb.dataset.tone = previewTone;
    }
    const fields: [string, string | undefined][] = [
      ["[data-preview-name]", previewName],
      ["[data-preview-metric]", previewMetric],
      ["[data-preview-pill]", previewLabel],
    ];
    for (const [selector, text] of fields) {
      const field = preview.querySelector<HTMLElement>(selector);
      if (field) {
        field.textContent = text ?? "";
      }
    }
  };

  const setupPreview = (): Cleanup | null => {
    const preview = document.querySelector<HTMLElement>("[data-preview]");
    if (!preview) {
      return null;
    }
    const canHover = window.matchMedia(
      "(hover: hover) and (pointer: fine) and (min-width: 960px)"
    );
    const target = { x: 0, y: 0 };
    const current = { x: 0, y: 0 };
    let frame = 0;

    const render = () => {
      const easing = prefersReducedMotion() ? 1 : FOLLOW_EASING;
      current.x += (target.x - current.x) * easing;
      current.y += (target.y - current.y) * easing;
      preview.style.transform = `translate3d(${current.x}px, ${current.y}px, 0)`;
      const settled =
        Math.abs(target.x - current.x) < 0.5 &&
        Math.abs(target.y - current.y) < 0.5;
      frame = settled ? 0 : window.requestAnimationFrame(render);
    };

    const follow = (event: MouseEvent) => {
      target.x = event.clientX + PREVIEW_OFFSET_X;
      target.y = event.clientY + PREVIEW_OFFSET_Y;
      if (frame === 0) {
        frame = window.requestAnimationFrame(render);
      }
    };

    const hide = () => preview.classList.remove("is-visible");

    for (const trigger of document.querySelectorAll<HTMLButtonElement>(
      "[data-accordion-trigger]"
    )) {
      trigger.addEventListener("mouseenter", (event) => {
        if (!canHover.matches) {
          return;
        }
        fillPreview(preview, trigger);
        if (!preview.classList.contains("is-visible")) {
          current.x = event.clientX + PREVIEW_OFFSET_X;
          current.y = event.clientY + PREVIEW_OFFSET_Y;
        }
        follow(event);
        preview.classList.add("is-visible");
      });
      trigger.addEventListener("mousemove", follow);
      trigger.addEventListener("mouseleave", hide);
    }

    window.addEventListener("scroll", hide, { passive: true });
    return () => {
      window.removeEventListener("scroll", hide);
      window.cancelAnimationFrame(frame);
    };
  };

  onPage(() => {
    setupAccordion();
    return setupPreview();
  });
</script>
