---
import "@fontsource-variable/geist";
import "lenis/dist/lenis.css";
import "~/styles/global.css";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";

import Grain from "~/components/grain.astro";
import Header from "~/components/header.astro";
import SectionNav from "~/components/section-nav.astro";
import { profile } from "~/data/profile";
import type { PageSection } from "~/data/sections";
import { homeSections } from "~/data/sections";

interface OgImage {
  alt: string;
  // A path under public/, 1200×630.
  src: string;
}

interface Props {
  description?: string;
  // Pages that shouldn't appear in search results, such as the 404.
  noindex?: boolean;
  og?: OgImage;
  ogType?: "article" | "profile" | "website";
  // schema.org JSON-LD for the page, from ~/data/seo.
  schema?: Record<string, unknown>;
  sections: PageSection[];
  title: string;
}

const defaultOg: OgImage = {
  alt: `${profile.name}, Senior Software Engineer. I build and maintain production web apps, end to end.`,
  src: "/og.jpg",
};

const {
  title,
  description = profile.description,
  noindex = false,
  og = defaultOg,
  ogType = "website",
  schema,
  sections,
} = Astro.props;
const [firstName, ...lastNames] = profile.name.split(" ");
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(og.src, Astro.site);
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover lets the page run under Safari's toolbars on iOS instead of
         stopping at their edge; anything pinned to an edge pads itself by the safe area. */}
    <meta
      content="width=device-width, initial-scale=1, viewport-fit=cover"
      name="viewport"
    />
    <title>{title}</title>
    <meta content={description} name="description" />
    {noindex && <meta content="noindex" name="robots" />}
    <link href={canonical} rel="canonical" />
    <link href="/favicon.ico" rel="icon" sizes="32x32" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" />
    <link href="/sitemap-index.xml" rel="sitemap" />
    <meta
      content="#fdfdfc"
      media="(prefers-color-scheme: light)"
      name="theme-color"
    />
    <meta
      content="#0b0b0c"
      media="(prefers-color-scheme: dark)"
      name="theme-color"
    />
    <meta content={ogType} property="og:type" />
    {ogType === "profile" && (
      <>
        <meta content={firstName} property="profile:first_name" />
        <meta content={lastNames.join(" ")} property="profile:last_name" />
        <meta content={profile.handle} property="profile:username" />
      </>
    )}
    <meta content="en_US" property="og:locale" />
    <meta content={profile.name} property="og:site_name" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogImage} property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content={og.alt} property="og:image:alt" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={`@${profile.handle}`} name="twitter:site" />
    <meta content={`@${profile.handle}`} name="twitter:creator" />
    {schema && (
      <script
        is:inline
        set:html={JSON.stringify(schema)}
        type="application/ld+json"
      />
    )}
    <script is:inline>
      (() => {
        const root = document.documentElement;
        // is-top: the page is near its top (see aurora.astro); kept in sync on scroll.
        root.classList.add("js", "is-top");
        let stored = "";
        try {
          stored = localStorage.getItem("theme") ?? "";
        } catch {
          // Storage can be blocked; fall back to the system theme.
        }
        const prefersDark = window.matchMedia(
          "(prefers-color-scheme: dark)"
        ).matches;
        const systemTheme = prefersDark ? "dark" : "light";
        const isExplicit = stored === "light" || stored === "dark";
        root.dataset.themePref = isExplicit ? stored : "system";
        root.dataset.theme = isExplicit ? stored : systemTheme;
        // Entrances wait until frames flow (is-ready). On a reload, iOS Safari keeps showing
        // the old page for a moment after the first paint, so an entrance started then played
        // unseen. Two frames back to back mean the page is on screen; after a second of
        // frames it goes anyway. A page loaded out of sight waits until it is shown.
        let firstFrame = 0;
        let lastFrame = 0;
        const waitForFrames = (time) => {
          firstFrame ||= time;
          if (
            (lastFrame && time - lastFrame < 50) ||
            time - firstFrame > 1000
          ) {
            root.classList.add("is-ready");
            return;
          }
          lastFrame = time;
          requestAnimationFrame(waitForFrames);
        };
        requestAnimationFrame(waitForFrames);
        // The router replaces <html> attributes with the next page's; carry the theme and state classes over.
        document.addEventListener("astro:before-swap", (event) => {
          const next = event.newDocument.documentElement;
          for (const name of root.classList) {
            if (
              name === "js" ||
              name === "is-ready" ||
              name === "is-top" ||
              name.startsWith("lenis")
            ) {
              next.classList.add(name);
            }
          }
          next.dataset.theme = root.dataset.theme;
          next.dataset.themePref = root.dataset.themePref;
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot name="background" />
    <div aria-hidden="true" class="page-texture">
      <Grain />
    </div>
    <Header sections={homeSections} />
    <slot />
    <SectionNav sections={sections} />
    <Analytics />
    <script>
      import { subscribeToScroll } from "~/scripts/scroll-state";
      import "~/scripts/reveal";
      import "~/scripts/page-transition";
      import "~/scripts/tab-title";
      import "~/scripts/analytics";
      import { startSmoothScroll } from "~/scripts/smooth-scroll";

      startSmoothScroll();
      subscribeToScroll(({ far }) => {
        document.documentElement.classList.toggle("is-top", !far);
      });
    </script>
  </body>
</html>

<style>
  /* The grain stays on screen while the page scrolls under it. As a layer the height of
     the whole page, Safari on iPhone kept painting it while scrolling and dropped the
     header's animation. */
  .page-texture {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  /* iOS Safari paints its top and bottom bars a solid colour when a full-width fixed layer
     with a background reaches the screen edge, instead of showing the page under them. So
     there the grain stops 8px short of both edges and fades in over the next 32px: it
     also shifts the page's brightness a little, and a hard stop would show as a band. */
  @supports (-webkit-touch-callout: none) {
    .page-texture {
      inset: 8px 0;
      mask-image: linear-gradient(
        transparent,
        #000 32px,
        #000 calc(100% - 32px),
        transparent
      );
    }
  }
</style>
